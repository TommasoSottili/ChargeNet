<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="700.0" prefWidth="400.0" styleClass="bg-flat"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.unifi.ing.chargenet.presentation.controller.LoginController">

    <center>
        <VBox alignment="CENTER" maxWidth="420.0" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="25.0" right="25.0" top="30.0" />
            </padding>
            <children>

                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label text="ChargeNet" styleClass="app-title" />
                        <Label text="Manage the charging of your electric car" styleClass="app-subtitle" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </VBox>

                <VBox spacing="20.0" styleClass="station-card">
                    <padding>
                        <Insets bottom="25.0" left="20.0" right="20.0" top="25.0" />
                    </padding>
                    <children>
                        <StackPane>
                            <VBox.margin>
                                <Insets bottom="5.0" />
                            </VBox.margin>
                            <children>
                                <Label text="WELCOME BACK" styleClass="section-title" />
                            </children>
                        </StackPane>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Email address" styleClass="form-label" />
                                <TextField fx:id="emailField" prefHeight="40.0"
                                           promptText="myaccount@email.com" styleClass="input-field">
                                    <font><Font size="14.0" /></font>
                                </TextField>
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Password" styleClass="form-label" />
                                <StackPane>
                                    <children>
                                        <TextField fx:id="passwordVisibleField" managed="false" visible="false"
                                                   prefHeight="40.0" promptText="Insert your Password"
                                                   styleClass="input-field">
                                            <font><Font size="14.0" /></font>
                                        </TextField>
                                        <PasswordField fx:id="passwordField" prefHeight="40.0"
                                                       promptText="Insert your Password" styleClass="input-field">
                                            <font><Font size="14.0" /></font>
                                        </PasswordField>
                                        <ImageView fx:id="togglePasswordIcon" fitHeight="20.0" fitWidth="20.0"
                                                   onMouseClicked="#togglePasswordVisibility" pickOnBounds="true"
                                                   preserveRatio="true" style="-fx-cursor: hand;"
                                                   StackPane.alignment="CENTER_RIGHT">
                                            <StackPane.margin><Insets right="10.0" /></StackPane.margin>
                                            <image>
                                                <Image url="@../images/view.png" />
                                            </image>
                                        </ImageView>
                                    </children>
                                </StackPane>
                                <HBox alignment="CENTER_RIGHT">
                                    <children>
                                        <Hyperlink text="Forgot Password?" styleClass="link" disable="true">
                                            <font><Font size="11.0" /></font>
                                        </Hyperlink>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Button fx:id="loginButton" maxWidth="Infinity" mnemonicParsing="false"
                                onAction="#handleLogin" prefHeight="45.0" styleClass="btn-primary" text="LOG IN">
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Button>
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label text="Don't have an account?" styleClass="text-muted" />
                        <Hyperlink onAction="#goToRegister" text="Sign up" styleClass="link" />
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>

            </children>
        </VBox>
    </center>
</BorderPane>