<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="it.unifi.ing.chargenet.presentation.controller.FinancialReportsController" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="400.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="20.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label onMouseClicked="#goBack" style="-fx-cursor: hand; -fx-text-fill: #7b6d6d;" text="&lt; Back">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label alignment="CENTER" style="-fx-text-fill: #131212;" text="Financials">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="      " />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="20.0">
                    <padding><Insets bottom="24.0" left="20.0" right="20.0" top="24.0" /></padding>
                    <children>

                        <!-- HERO: ricavo totale -->
                        <VBox alignment="CENTER" prefHeight="180.0" style="-fx-background-color: linear-gradient(to bottom right, #FFA726, #F57C00); -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(245,124,0,0.35), 20, 0, 0, 8);">
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                            <children>
                                <Label style="-fx-text-fill: #FFF3E0;" text="TOTAL REVENUE">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>
                                <Label fx:id="payoutLabel" style="-fx-text-fill: white;" text="€ 0.00">
                                    <font><Font name="System Bold" size="46.0" /></font>
                                    <VBox.margin><Insets bottom="4.0" top="4.0" /></VBox.margin>
                                </Label>
                                <Label style="-fx-text-fill: #FFE0B2;" text="Net earnings from your stations">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <Label style="-fx-text-fill: #7b6d6d;" text="Performance">
                            <font><Font name="System Bold" size="13.0" /></font>
                            <VBox.margin><Insets bottom="-6.0" left="2.0" top="2.0" /></VBox.margin>
                        </Label>

                        <!-- Metriche secondarie -->
                        <HBox spacing="15.0">
                            <children>
                                <VBox alignment="CENTER_LEFT" prefHeight="95.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 16; -fx-border-color: #1565C0 transparent transparent transparent; -fx-border-width: 3 0 0 0; -fx-border-radius: 14 14 0 0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 12, 0, 0, 4);" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-text-fill: #7b6d6d;" text="Total Sessions">
                                            <font><Font size="12.0" /></font>
                                        </Label>
                                        <Label fx:id="sessionsLabel" style="-fx-text-fill: #1565C0;" text="0">
                                            <font><Font name="System Bold" size="26.0" /></font>
                                            <VBox.margin><Insets top="4.0" /></VBox.margin>
                                        </Label>
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER_LEFT" prefHeight="95.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 16; -fx-border-color: #f59100 transparent transparent transparent; -fx-border-width: 3 0 0 0; -fx-border-radius: 14 14 0 0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 12, 0, 0, 4);" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-text-fill: #7b6d6d;" text="Energy Sold">
                                            <font><Font size="12.0" /></font>
                                        </Label>
                                        <Label fx:id="energyLabel" style="-fx-text-fill: #f59100;" text="0.0 kWh">
                                            <font><Font name="System Bold" size="26.0" /></font>
                                            <VBox.margin><Insets top="4.0" /></VBox.margin>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>