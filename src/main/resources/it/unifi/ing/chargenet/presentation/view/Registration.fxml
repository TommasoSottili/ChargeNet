                                    <VBox spacing="5.0">
                                       <children>
                                          <Label text="Connector Type" style="-fx-text-fill: #333333;">
                                             <font><Font name="System Bold" size="12.0" /></font>
                                          </Label>
                                          <ComboBox fx:id="connectorTypeComboBox" prefHeight="40.0" prefWidth="420.0"
                                                    promptText="Select your vehicle connector..."
                                                    style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-background-radius: 8; -fx-border-radius: 8;" />
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>

                              <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleRegister" prefHeight="45.0" style="-fx-background-color: #F59100; -fx-background-radius: 8; -fx-cursor: hand; -fx-text-fill: white;" text="REGISTER NOW">
