                                    <ComboBox fx:id="roleComboBox" prefHeight="40.0" prefWidth="420.0" promptText="Choose driver or manager..." style="-fx-background-color: white; -fx-border-color: #CCCCCC; -fx-background-radius: 8; -fx-border-radius: 8;" />
