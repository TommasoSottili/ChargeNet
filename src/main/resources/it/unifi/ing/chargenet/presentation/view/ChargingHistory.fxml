<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="it.unifi.ing.chargenet.presentation.controller.ChargingHistoryController" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="400.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="20.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label onMouseClicked="#goBack" style="-fx-cursor: hand; -fx-text-fill: #7b6d6d;" text="&lt; Back">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Charging History" style="-fx-text-fill: #131212;">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="      " />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" BorderPane.alignment="CENTER">
            <content>
                <StackPane style="-fx-background-color: #F8F9FA;">
                    <children>
                        <VBox maxWidth="440.0" spacing="18.0">
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                            <children>

                                <!-- STATISTICHE -->
                                <HBox spacing="15.0">
                                    <children>
                                        <VBox alignment="CENTER" prefHeight="90.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Total Spent" style="-fx-text-fill: #7b6d6d;"><font><Font size="12.0" /></font></Label>
                                                <Label fx:id="totalSpentLabel" text="€ 0.00" style="-fx-text-fill: #f59100;"><font><Font name="System Bold" size="24.0" /></font></Label>
                                            </children>
                                        </VBox>
                                        <VBox alignment="CENTER" prefHeight="90.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Total Energy" style="-fx-text-fill: #7b6d6d;"><font><Font size="12.0" /></font></Label>
                                                <Label fx:id="totalEnergyLabel" text="0 kWh" style="-fx-text-fill: #131212;"><font><Font name="System Bold" size="22.0" /></font></Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Label text="Recent Sessions" style="-fx-text-fill: #131212;">
                                    <font><Font name="System Bold" size="16.0" /></font>
                                </Label>

                                <!-- Riempito dinamicamente dal controller -->
                                <VBox fx:id="sessionsContainer" spacing="12.0" />

                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>