@startuml ChargeNet_dao

title ChargeNet - DAO

skinparam shadowing false
skinparam ClassAttributeIconSize 0
skinparam Linetype ortho
skinparam RoundCorner 10
skinparam Nodesep 40
skinparam Ranksep 40
skinparam defaultFontName Arial
skinparam DefaultFontSize 12
skinparam BorderColor #333333
skinparam ArrowColor #333333
top to bottom direction

skinparam class {
  BackgroundColor #FFFFFF
}

skinparam package {
  BorderColor #8c8c8c
  FontStyle   bold
}

package "dao" #d3f4d7 {

  package "interfaces" #F0F4F8 {

    interface GenericDao<T> {
      + save(entity: T): void
      + findById(id: Long): T
      + findAll(): List<T>
      + update(entity: T): void
      + delete(id: Long): void
    }

    interface DaoFactory {
      + createSessionDao(connection: Connection): SessionDao
      + createStationDao(connection: Connection): StationDao
      + createUserDao(connection: Connection): UserDao
      + createTransactionDao(connection: Connection): TransactionDao
      + createRatingDao(connection: Connection): RatingDao
      + createRatingAlertDao(connection: Connection): RatingAlertDao
      + createTransformerDao(connection: Connection): TransformerDao
    }

    interface UserDao {
      + findByEmail(mail: String): User
      + findByRole(role: Role): List<User>
    }
    GenericDao <|-- UserDao

    interface StationDao {
      + findByStatus(status: StationStatus): List<ChargingStation>
      + findByOperator(operatorId: Long): List<ChargingStation>
      + findByConnectorType(type: ConnectorType): List<ChargingStation>
      + findNearestAvailable(lat: double, lng: double, type: ConnectorType, excludeId: Long): List<ChargingStation>
      + findByTransformer(transformerId: Long): List<ChargingStation>
      + expireHolds(): void
      + findActive(): List<ChargingStation>
      + acquireAtomicHold(stationId: Long, dirverId: Long): boolean
      + countByTransformer(transformerId: Long): int 
      + findAll(): List<ChargingStation> 
    }
    GenericDao <|-- StationDao

    interface TransformerDao {
      + findOverheated(): List<PowerTransformer>
    }
    GenericDao <|-- TransformerDao

    interface SessionDao {
      + findByDriver(driverId: Long): List<ChargingSession>
      + findActiveSessions(): List<ChargingSession>
      + findActiveByStation(stationId: Long): List<ChargingSession>
      + findActiveByDriverId(driverId: Long): ChargingSession
      + countByOperatorId(operatorId: Long): int
      + sumEnergyByOperatorId(operatorId: Long): double
      + findCompletedByDriverId(driverId: Long): List<ChargingSession>
    }
    GenericDao <|-- SessionDao

    interface TransactionDao {
      + findByDriver(driverId: Long): List<Transaction>
      + findByType(type: TransactionType): List<Transaction>
    }
    GenericDao <|-- TransactionDao

    interface RatingDao {
      + findByStation(stationId: Long): List<Rating>
      + findByDriver(driverId: Long): List<Rating>
      + existsByDriverAndSession(driverId: Long, sessionId: Long): boolean
      + recalculateAverage(stationId: Long): void
    }
    GenericDao <|-- RatingDao

    interface RatingAlertDao {
      + findByStatus(status: RatingAlertStatus): List<RatingAlert>
      + existsOpenAlertForStation(stationId: Long): boolean
      + findByStation(stationId: Long): List<RatingAlert>
    }
    GenericDao <|-- RatingAlertDao

  }

  package "postgres" #F0F4F8 {

    class DatabaseManager {
      - {static} URL: String
      - {static} USER: String
      - {static} PASSWORD: String
      - {static} TARIFF_PLATFORM: double = 0.05

      + {static} getConnection(): Connection
      + initializeSchema(): void {static}
    }

    class PostgresUserDao {
      - connection: Connection
      + save(entity: User): void
      + findById(id: Long): User
      + findAll(): List<User>
      + update(entity: User): void
      + delete(id: Long): void
      + findByEmail(email: String): User
      + findByRole(role: Role): List<User>
    }
    UserDao <|.. PostgresUserDao
    PostgresUserDao ..> DatabaseManager : <<use>>

    class PostgresStationDao {
      - connection: Connection
      + save(station: ChargingStation): void
      + findById(id: Long): ChargingStation
      + findAll(): List<ChargingStation>
      + update(station: ChargingStation): void
      + delete(id: Long): void
      + findByStatus(status: StationStatus): List<ChargingStation>
      + findByOperator(operatorId: Long): List<ChargingStation>
      + findByConnectorType(type: ConnectorType): List<ChargingStation>
      + findNearestAvailable(lat: double, lng: double, type: ConnectorType, excludeId: Long): List<ChargingStation>
      + findByTransformer(transformerId: Long): List<ChargingStation>
      + findActive(): List<ChargingStation>
      + expireHolds(): void
      + acquireAtomicHold(stationId: Long, driverId: Long): boolean
      + countByTransformer(transformerId: Long): int
    }
    StationDao <|.. PostgresStationDao
    PostgresStationDao ..> DatabaseManager : <<use>>

    class PostgresTransformerDao {
      - connection: Connection
      + save(transformer: PowerTransformer): void
      + findById(id: Long): PowerTransformer
      + findAll(): List<PowerTransformer>
      + update(transformer: PowerTransformer): void
      + delete(id: Long): void
      + findOverheated(): List<PowerTransformer>
    }
    TransformerDao <|.. PostgresTransformerDao
    PostgresTransformerDao ..> DatabaseManager : <<use>>

    class PostgresSessionDao {
      - connection: Connection
      + save(session: ChargingSession): void
      + findById(id: Long): ChargingSession
      + findAll(): List<ChargingSession>
      + update(session: ChargingSession): void
      + delete(id: Long): void
      + findByDriver(driverId: Long): List<ChargingSession>
      + findActiveSessions(): List<ChargingSession>
      + findActiveByStation(stationId: Long): List<ChargingSession>
      + findActiveByDriverId(driverId: Long): ChargingSession
      + findCompletedByDriverId(driverId: Long): List<ChargingSession>
      + countByOperatorId(operatorId: Long): int
      + sumEnergyByOperatorId(operatorId: Long): double
    }
    SessionDao <|.. PostgresSessionDao
    PostgresSessionDao ..> DatabaseManager : <<use>>

    class PostgresTransactionDao {
      - connection: Connection
      + save(transaction: Transaction): void
      + findById(id: Long): Transaction
      + findAll(): List<Transaction>
      + update(transaction: Transaction): void {unsupported}
      + delete(id: Long): void {unsupported}
      + findByDriver(driverId: Long): List<Transaction>
      + findByType(type: TransactionType): List<Transaction>
    }
    TransactionDao <|.. PostgresTransactionDao
    PostgresTransactionDao ..> DatabaseManager : <<use>>

    class PostgresRatingDao {
      - connection: Connection
      --
      + save(rating: Rating): void
      + findById(id: Long): Rating
      + findAll(): List<Rating> {unsupported}
      + update(rating: Rating): void {unsupported}
      + delete(id: int): void {unsupported}
      + findByStation(stationId: Long): List<Rating>
      + findByDriver(driverId: Long): List<Rating>
      + existsByDriverAndSession(driverId: Long, sessionId: Long): boolean
      + recalculateAverage(stationId: Long): void
    }
    RatingDao <|.. PostgresRatingDao
    PostgresRatingDao ..> DatabaseManager : <<use>>

    class PostgresRatingAlertDao {
      - connection: Connection
      --
      + save(alert: RatingAlert): void
      + findById(id: Long): RatingAlert
      + findAll(): List<RatingAlert> {unsupported}
      + update(alert: RatingAlert): void 
      + delete(id: int): void {unsupported}
      + findByStatus(status: RatingAlertStatus): List<RatingAlert>
      + existsOpenAlertForStation(stationId: Long): boolean
      + findByStation(stationId: Long): List<RatingAlert>
    }
    RatingAlertDao <|.. PostgresRatingAlertDao
    PostgresRatingAlertDao ..> DatabaseManager : <<use>>

    class PostgresDaoFactory {
      + createSessionDao(connection: Connection): SessionDao
      + createStationDao(connection: Connection): StationDao
      + createUserDao(connection: Connection): UserDao
      + createTransactionDao(connection: Connection): TransactionDao
      + createRatingDao(connection: Connection): RatingDao
      + createRatingAlertDao(connection: Connection): RatingAlertDao
      + createTransformerDao(connection: Connection): TransformerDao
    }
    DaoFactory <|.. PostgresDaoFactory 

  }


}

"dao.interfaces" -[hidden]down- "dao.postgres"

@enduml