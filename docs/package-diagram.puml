@startuml ChargeNet_Package_Diagram
skinparam ClassAttributeIconSize 0
skinparam shadowing false
skinparam RoundCorner 10
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam Linetype ortho
top to bottom direction

skinparam class {
    BackgroundColor #FFFFFF
}

skinparam package {
    BorderColor #8c8c8c
    FontStyle bold
}

' Palette allineata a quella dei diagrammi di classe:
' presentation #f9e8e7 | business #fce3bd | domain #dce7f0 | dao #d3f4d7
skinparam package<<ui>> {
    BackgroundColor #f9e8e7
}
skinparam package<<business>> {
    BackgroundColor #fce3bd
}
skinparam package<<domain>> {
    BackgroundColor #dce7f0
}
skinparam package<<persistence>> {
    BackgroundColor #d3f4d7
}

' ==========================================
' PRESENTATION LAYER (UI)
' ==========================================
package "presentation" <<ui>> as presentation {
    package "navigation"
    package "core"
    package "controller"
}

' ==========================================
' BUSINESS LAYER (LOGIC)
' ==========================================
package "business" <<business>> as business {
    package "services"
    package "business.core"
    package "strategies"
    package "utils"
}

' ==========================================
' DOMAIN LAYER (MODELS)
' ==========================================
package "domain" <<domain>> as domain {
    package "users"
    package "infrastructure"
    package "sessions"
    package "financials"
    package "feedback"
    package "observer"
}

' ==========================================
' DAO LAYER (PERSISTENCE)
' ==========================================
package "dao" <<persistence>> as dao {
    package "interfaces" 
    package "postgres" 
}

database "PostgreSQL" 

' ==========================================
' RELAZIONI E DIPENDENZE
' ==========================================
controller ..> services 
presentation ..> domain

services ..> interfaces 
services ..> domain 
strategies ..> domain 
"business.core" ..> domain 

postgres ..> interfaces 
dao ..> domain 

postgres ..> PostgreSQL

' ==========================================
' ALLINEAMENTO SPAZIALE FORZATO
' ==========================================
presentation -[hidden]down- business
business -[hidden]down- domain
domain -[hidden]down- dao

' ==========================================
' LEGENDA
' ==========================================
legend bottom left
|= Colore |= Layer Architetturale |
| <back:#f9e8e7>   </back> | Presentation (UI) |
| <back:#fce3bd>   </back> | Business Logic |
| <back:#dce7f0>   </back> | Domain Model |
| <back:#d3f4d7>   </back> | Persistence (DAO) |
endlegend

@enduml