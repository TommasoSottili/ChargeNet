@startuml ChargeNet_Package_Diagram
skinparam ClassAttributeIconSize 0
skinparam shadowing false
skinparam RoundCorner 10
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam Linetype ortho
top to bottom direction

skinparam class {
    BackgroundColor #FFFFFF
}

skinparam package {
    BorderColor #8c8c8c
    FontStyle bold
}

skinparam package<<ui>> {
    BackgroundColor #BEE3F8
}
skinparam package<<business>> {
    BackgroundColor #C6F6D5
}
skinparam package<<domain>> {
    BackgroundColor #FEFCBF
}
skinparam package<<persistence>> {
    BackgroundColor #FED7D7
}

' ==========================================
' PRESENTATION LAYER (UI)
' ==========================================
package "presentation" <<ui>> as presentation {
    package "navigation"
    package "core"
    package "controller"
}

' ==========================================
' BUSINESS LAYER (LOGIC)
' ==========================================
package "business" <<business>> as business {
    package "services"
    package "core" as businesscore
    package "strategies"
    package "utils"
}

' ==========================================
' DOMAIN LAYER (MODELS)
' ==========================================
package "domain" <<domain>> as domain {
    package "users"
    package "infrastructure"
    package "sessions"
    package "financials"
    package "feedback"
    package "observer"
}

' ==========================================
' DAO LAYER (PERSISTENCE)
' ==========================================
package "dao" <<persistence>> as dao {
    package "interfaces" 
    package "postgres" 
}

database "PostgreSQL" 

' ==========================================
' RELAZIONI E DIPENDENZE
' ==========================================
controller ..> services : <<invokes>>
presentation ..> domain : <<uses>>

services ..> interfaces : <<uses>>
services ..> domain : <<manipulates>>
strategies ..> domain : <<uses>>
businesscore ..> domain : <<uses>>

postgres ..> interfaces : <<implements>>
dao ..> domain : <<maps>>

postgres ..> PostgreSQL : <<persists>>

' REGOLA D'ORO: nessuna freccia esce dal package domain.
' Il Domain Model non dipende da nessun altro livello.
note right of domain
  **Il domain non dipende da nulla.**
  Nessuna classe sotto //domain// importa
  //business//, //dao// o //presentation//:
  tutte le frecce entrano, nessuna esce.
end note

' ==========================================
' ALLINEAMENTO SPAZIALE FORZATO
' ==========================================
presentation -[hidden]down- business
business -[hidden]down- domain
domain -[hidden]down- dao

' ==========================================
' LEGENDA
' ==========================================
legend bottom left
|= Colore |= Layer Architetturale |
| <back:#BEE3F8>   </back> | Presentation (UI) |
| <back:#C6F6D5>   </back> | Business Logic |
| <back:#FEFCBF>   </back> | Domain Model |
| <back:#FED7D7>   </back> | Persistence (DAO) |
endlegend

@enduml