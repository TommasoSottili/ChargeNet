@startuml ChargeNet_DomainModel

title ChargeNet - Domain Model

skinparam titleFontSize 40


' ══════════════════════════════════════════════
'  SCALA E LAYOUT
' ══════════════════════════════════════════════

skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 10
skinparam classAttributeIconSize 0
skinparam nodesep 60
skinparam ranksep 80
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam BorderColor #333333
skinparam ArrowColor #333333

skinparam class {
    BackgroundColor #FFFFFF
}

skinparam package {
    BorderColor #8c8c8c
    FontStyle   bold
}

' ══════════════════════════════════════════════
'  PACKAGE ESTERNI
' ══════════════════════════════════════════════

package "business" as PKG_BUSINESS #fce3bd {
    class LoadBalancerService {
        + update(src: Subject, e: TransformerEvent): void
    }
    class SessionService {
        + openSession(...): ChargingSession
        + closeSession(...): Transaction
    }
    class StationService {
        + findNearestAvailable(...): List<ChargingStation>
    }
}

package " dao" as PKG_DAO  #d3f4d7 {
    interface UserDao {
        + findByEmail(email: String): User
    }
    interface StationDao {
        + findActive(): List<ChargingStation>
        + findByConnector(t: ConnectorType): List<ChargingStation>
    }
    interface SessionDao {
        + findActiveByStation(id: int): List<ChargingSession>
    }
}

' ══════════════════════════════════════════════
'  PACKAGE DOMAIN
' ══════════════════════════════════════════════
package "domain" as PKG_DOMAIN #dce7f0 {

    ' ─────────────────────────────────────────
    '  SUB-PACKAGE: observer
    ' ─────────────────────────────────────────
    package "observer" as PKG_OBSERVER #F0F4F8 {

        interface Subject {
            + attach(o: Observer): void
            + detach(o: Observer): void
            + notifyObservers(e: TransformerEvent): void
        }

        interface Observer {
            + update(src: Subject, e: TransformerEvent): void
        }

        enum TransformerEvent {
            THERMAL_ALERT
            COOLING_COMPLETE
        }
    }

    ' ─────────────────────────────────────────
    '  SUB-PACKAGE: users
    ' ─────────────────────────────────────────
    package "users" as PKG_USERS #F0F4F8 {

        abstract class User <<abstract>> {
            - id: Long
            - name: String
            - email: String
            - password: String
            - role: Role
            
            + User(id, name, email, pwd, role)
            + getRole(): Role
            + getId(): Long
            + getName(): String
            + getEmail(): String
            + getPassword(): String
        }

        class Driver {
            - latitude: Double
            - longitude: Double
            - connectorType: ConnectorType
            - subscriptionPlan: SubscriptionPlan
            - batteryCapacity: Double
            - walletBalance: BigDecimal
            
            + getDiscount(): double
            + hasSufficientBalance(amount: BigDecimal): boolean
            + charge(amount: BigDecimal): void
            + refund(amount: BigDecimal): void
            + updatePlan(newPlan: SubscriptionPlan): BigDecimal
            + updatePosition(latitude: double, longitude: double): void
        }

        class StationOperator {
            - totalEarnings: BigDecimal
            
            + addEarnings(amount: BigDecimal): void

        }

        class EnergyManager {
        }

        together{
            enum Role {
                DRIVER
                STATION_OPERATOR
                ENERGY_MANAGER
            }

            enum SubscriptionPlan <<(E) rich>> {
                BASIC
                PLUS
                PREMIUM
                --
                 - discount: double
                 - monthlyFee: BigDecimal
                
            }

            enum ConnectorType <<(E) rich>> {
                TYPE_2
                CCS_2
                CHADEMO
                --
                - maxPowerKw: double            
            }
        }

        ' Disposizione layout package users
        User -[hidden]down-> StationOperator
        User -[hidden]down-> EnergyManager
        User -[hidden]down-> Driver 
        Role -[hidden]left-> ConnectorType
    }

    ' ─────────────────────────────────────────
    '  SUB-PACKAGE: infrastructure
    ' ─────────────────────────────────────────
    package "infrastructure" as PKG_INFRA #F0F4F8 {

        class PowerTransformer {
            - id: Long
            - name: String
            - temperature: double
            - loadPercent: double
            - observers: List<Observer>
            - MAX_HEAT_PER_TICK: double = 30.0 {static}
            
            + simulateTick(totalHeatIncrement: double): void
            + isInThermalAlert(): boolean
            + attach(o: Observer): void
            + detach(o: Observer): void
            + notifyObservers(e: TransformerEvent): void
        }

        class ChargingStation {
            - id: Long 
            - name: String
            - address: String
            - latitude: Double
            - longitude: Double
            - powerKw: Double
            - isSolarPowered: boolean
            - tariffOperator: BigDecimal
            - tariffPlatform: BigDecimal
            - averageRating: Double
            - totalRatings: Integer
            - status: StationStatus
            - expirationTimeStamp: LocalDateTime
            - connectorType: ConnectorType
            - reservedBy: Driver
            
            
            + {static} register(...): ChargingStation
            + isAvailableFor(type: ConnectorType): boolean
            + isReservedBy(driver: Driver): boolean
            + activate(platformTariff: BigDecimal): void
            + priceFor(kwh: double, driver: Driver): BigDecimal
            + reject(): void
            + setReserved(d: Driver): void
            + cancelHold(): void
            + setBusy(): void
            + setActive(): void
            + setOverloaded(): void
            + setSuspended(): void
            + updateRating(newStars: int): void
            + clearReservation(): void
        }

        enum StationStatus {
            PENDING_VERIFICATION
            ACTIVE
            RESERVED
            BUSY
            OVERLOADED
            SUSPENDED
            REJECTED
        }

        enum Zone {
            CENTRO_STORICO
            NOVOLI
            CAMPO_DI_MARTE
            RIFREDI
            GAVINANA
            ISOLOTTO
            COVERCIANO
            --
            - lable: String
            - baseLat: double
            - baseLng: double
           --
            + resolveWithJitter(): double[]
            + toString(): String
         }
    }

    ' ─────────────────────────────────────────
    '  SUB-PACKAGE: sessions
    ' ─────────────────────────────────────────
    package "sessions" as PKG_SESSIONS #F0F4F8 {

        class ChargingSession {
            - id: Long
            - strategyUsed: ChargingType
            - batteryStart: Double
            - batteryCurrent: Double
            - kwhDelivered: Double
            - costTotal: BigDecimal
            - status: SessionStatus
            - openedAt: LocalDateTime
            - closedAt: LocalDateTime
            
            + {static} open(...): ChargingSession
            + addTick(kwhThisTick: Double, costThisTick: BigDecimal): void
            + complete(): void
            + interrupt(): void
            + isActive(): boolean
        }

        enum SessionStatus {
            ACTIVE
            COMPLETED
            INTERRUPTED_THERMAL
        }

        enum ChargingType {
            FAST 
            ECO
        }
    }

    ' ─────────────────────────────────────────
    '  SUB-PACKAGE: financials
    ' ─────────────────────────────────────────
    package "financials" as PKG_FINANCE #F0F4F8 {

        class Transaction <<immutable>> {
            - id: Long
            - type: TransactionType
            - amount: BigDecimal
            - kwh: Double
            - description: String
            - createdAt: LocalDateTime
            
            + {static} create(...): Transaction
        }

        enum TransactionType {
            CHARGE
            REFUND
            FUND_ADDED
            SUBSCRIPTION
        }
    }

    ' ─────────────────────────────────────────
    '  SUB-PACKAGE: feedback
    ' ─────────────────────────────────────────
    package "feedback" as PKG_FEEDBACK #F0F4F8 {

        class Rating <<immutable>> {
            - id: Long
            - stars: Integer
            - comment: String
            - createdAt: LocalDateTime
            
            + {static} leave(...): Rating
        }

        class RatingAlert {
            - id: Long
            - avgAtCreation: Double
            - status: RatingAlertStatus
            - managerNote: String
            - createdAt: LocalDateTime
            
            + {static} create(...): RatingAlert
            + resolveSuspend(note: String): void
            + resolveIgnore(note: String): void
            + isPending(): boolean
        }

        enum RatingAlertStatus {
            PENDING
            RESOLVED_SUSPENDED
            RESOLVED_IGNORED
        }
    }

    ' ══════════════════════════════════════════
    '  RELAZIONI INTERNE AL DOMAIN
    ' ══════════════════════════════════════════

    ' Observer
    PowerTransformer ..|> Subject                         : «implements»
    Subject "1" -left-> "*" Observer                     : notifies

    ' Gerarchia User
    User <|-- Driver
    User <|-- StationOperator
    User <|-- EnergyManager

    ' Infrastructure
    StationOperator "1" <-- "1..*" ChargingStation
    PowerTransformer "1" <-left- "1..*" ChargingStation
    ChargingStation -left-> StationStatus                 
    ChargingStation "1" --> "0..1" Driver                 : reservedBy >

    ' Sessions
    Driver "1" <-up- "*" ChargingSession
    ChargingStation "1" <-left- "*" ChargingSession       : hosts >
    ChargingSession -left-> SessionStatus 
    ChargingSession -right-> ChargingType : <<uses>>                

    ' Financials
    Driver "  1" <-down- "*" Transaction                     : has >
    Transaction -left-> TransactionType                   

    ' Feedback
    Driver " 1  " <-down- "*" Rating
    ChargingStation "1" <-down- "*" Rating
    ChargingSession "1" <-down- "0..1" Rating             : generates >
    ChargingStation "1" <-down- "*" RatingAlert               : triggers >
    RatingAlert -left-> RatingAlertStatus                 : «uses»

    ' Enum ricchi
    Driver .up.> ConnectorType   
    ChargingStation .up.> ConnectorType                           
    Driver .up.> SubscriptionPlan                           
    PowerTransformer .left.> TransformerEvent                 

    ' Hidden links per layout quadrato (griglia 2x3)
    PKG_OBSERVER -[hidden]right- PKG_USERS
    PKG_INFRA -[hidden]up- PKG_SESSIONS
    PKG_FINANCE -[hidden]right- PKG_FEEDBACK
    PKG_OBSERVER -[hidden]down- PKG_INFRA
    PKG_USERS -[hidden]down- PKG_SESSIONS
    PKG_INFRA -[hidden]down- PKG_FINANCE

    PKG_BUSINESS -[hidden]up- PKG_OBSERVER


}

' ══════════════════════════════════════════════
'  RELAZIONI CON LAYER ESTERNI
' ══════════════════════════════════════════════
LoadBalancerService ..|> Observer                         : «implements»
LoadBalancerService ..> PowerTransformer                  : «observes»
SessionService ..> ChargingSession                        
SessionService ..> Driver                                 
StationService ..> ChargingStation                       

StationDao ..> ChargingStation                            
SessionDao ..> ChargingSession                            
UserDao ..> User                                          

@enduml