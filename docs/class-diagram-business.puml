@startuml ChargeNet_BusinessLayer

title ChargeNet - Business Layer (Service & Coordination)

skinparam titleFontSize 30
top to bottom direction

skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 10
skinparam classAttributeIconSize 0
skinparam nodesep 60
skinparam ranksep 70

skinparam defaultFontName Arial
skinparam BorderColor #333333
skinparam ArrowColor #333333

skinparam class {
    BackgroundColor #FFFFFF
}

skinparam package {
    FontStyle bold
}

' ==========================================
'  DOMAIN LAYER (Riferimento Esterno)
' ==========================================
package "domain" as PKG_DOMAIN #dce7f0 {
    together {
        class PowerTransformer
        interface Subject
        interface Observer
        enum TransformerEvent
    }
}

' ==========================================
'  BUSINESS LAYER
' ==========================================
package "business" as PKG_BUSINESS #fce3bd {

    package "core" as PKG_CORE #F0F4F8 {

        class GridMonitor <<Thread Daemon>> {
            - sessionService: SessionService
            - stationService: StationService
            - ratingService: RatingService
            __
            + run(): void
            - onTick(): void
            - processActiveSessions(): Map<PowerTransformer, Double>
            - processTransformers(heatMap: Map<PowerTransformer, Double>): void
            - expireShortTermHolds(): void
            - checkRatingAlerts(): void
            - findBestTransformerById(id: Long): PowerTransformer
        }

        class GridCluster <<Singleton>> {
            - {static} instance: GridCluster
            - transformers: List<PowerTransformer>
            - stationsByTransformer: Map<Long, List<ChargingStation>>
            - allStations: List<ChargingStation>
            __
            + {static} getInstance(): GridCluster
            + init(tDao: TransformerDao, sDao: StationDao): void
            + registerNewStation(s: ChargingStation): void
            + getTransformers(): List<PowerTransformer>
            + getStationsForTransformer(id: Long): List<ChargingStation>
            + getNearestAvailable(lat: double, lon: double): List<ChargingStation>
        }
    }

    package "strategies" as PKG_STRATEGIES #F0F4F8 {

        interface ChargingStrategy <<interface>> {
            + calculateCost(kwh: double, station: ChargingStation, driver: Driver): double
            + getHeatIncrement(): double
            + getType(): ChargingType
            + fromEnum(type: ChargingType): ChargingStrategy {static}
        }

        class FastChargingStrategy {
            - HEAT_PER_TICK: double = 8.0 {static} 
            
            + calculateCost(kwh: double, station: ChargingStation, driver: Driver): double
            + getHeatIncrement(): double
            + getType(): ChargingType
        }

        class EcoChargingStrategy {
            - HEAT_PER_TICK: double = 4.0 {static} 
            + calculateCost(kwh: double, station: ChargingStation, driver: Driver): double
            + getHeatIncrement(): double
            + getType(): ChargingType
        }
    }

    package "services" as PKG_SERVICES #F0F4F8 {

        class SessionService <<Service>> {
            - daoFactory: DaoFactory
            __
            + openSession(...): ChargingSession
            + addTick(session: ChargingSession, strategy: ChargingStrategy): void
            + closeSession(session: ChargingSession): Transaction
            + forceClose(session: ChargingSession): Transaction
            + getActiveSessions(): List<ChargingSession>
            + countSessionsByOperator(operator: StationOperator): int
            + calculateTotalEnergySoldByOperator(operator: StationOperator): double
            + getSessionHistoryByDriver(driver: Driver): List<ChargingSession>
            + getActiveSessionForDriver(driver: Driver): ChargingSession
            + getSessionById(sessionId: Long): ChargingSession
        }

        class LoadBalancerService <<Observer>> {
            - sessionService: SessionService
            - daoFactory: DaoFactory          
            __
           
            + update(source: Subject, event: TransformerEvent): void
            - handleThermalAlert(transformer: PowerTransformer): void
            - handleCoolingComplete(transformer: PowerTransformer): void

        }

        class StationService <<Service>> {
             - daoFactory: DaoFactory
             __
            + registerStation(operator: StationOperator, transformer: PowerTransformer, ...): ChargingStation
            + registerStation(operator: StationOperator, name: String, ...): ChargingStation
            + hold(driver: Driver, station: ChargingStation): void
            + cancelHold(driver: Driver, station: ChargingStation): void
            + expireHolds(): void
            + findNearestAvailable(driver: Driver): List<ChargingStation>
            + getStationsByOperator(operator: StationOperator): List<ChargingStation>
            + getAllStations(): List<ChargingStation>
            + getOverloadedStations(): List<ChargingStation>
            + getPendingStations(): List<ChargingStation>
            - findBestTransformer(connection: Connection): PowerTransformer
        }

        class DriverService <<Service>> {
            - daoFactory: DaoFactory
            --
            + updateDriverLocation(driver: Driver, newLat: double, newLng: double): void
        }

        class AuthService <<Service>> {
            - daoFactory: DaoFactory
            - currentUser: User
            __
            + register(...): User
            + registerDriver(...): Driver
            + login(email: String, rawPassword: String): User
            + logout(): void
            + refreshUser(userId: Long): User
        }

        class ValidationService <<Service>> {
            - daoFactory: DaoFactory
            __
            + approve(station: ChargingStation, platformTariff: BigDecimal): void
            + reject(station: ChargingStation, motivation: String): void
        }

        class RatingService <<Service>> {
            - daoFactory: DaoFactory
            __
            + leaveRating(...): Rating
            + checkRatingAlerts(): void
            + getPendingAlerts(): List<RatingAlert>
            + suspendStationFromAlert(alert: RatingAlert, notes: String): void
            + dismissAlert(alert: RatingAlert, notes: String): void
            - checkRatingAlert(connection: Connection, station: ChargingStation): void
        }

        class WalletService <<Service>> {
            - daoFactory: DaoFactory
            __
            + fundWallet(driver: Driver, amount: BigDecimal): Transaction
            + changePlan(driver: Driver, plan: SubscriptionPlan): Transaction
        }
    }
}

' ==========================================
'  DAO LAYER (Riferimento Esterno)
' ==========================================
package "dao.interfaces" as PKG_DAO #d3f4d7 {
    Interface DaoFactory<<interface>> {
      + createSessionDao(connection: Connection): SessionDao
      + createStationDao(connection: Connection): StationDao
      + createUserDao(connection: Connection): UserDao
      + createTransactionDao(connection: Connection): TransactionDao
      + createRatingDao(connection: Connection): RatingDao
      + createRatingAlertDao(connection: Connection): RatingAlertDao
      + createTransformerDao(connection: Connection): TransformerDao
    }
}

' ==========================================
' POSIZIONAMENTO (Layout Architetturale)
' ==========================================

' 1. Struttura a "Hamburger": Domain in alto, Business al centro, DAO in basso
PKG_DOMAIN -[hidden]down-> PKG_BUSINESS
PKG_BUSINESS -[hidden]down-> PKG_DAO

' 2. Layout interno al Business: Core e Strategies sopra, Services sotto
PKG_CORE -[hidden]right-> PKG_STRATEGIES
PKG_CORE -[hidden]down-> PKG_SERVICES
PKG_STRATEGIES -[hidden]down-> PKG_SERVICES

' 3. Compattiamo i Services in due colonne verticali forzate
AuthService -[hidden]down-> DriverService
DriverService -[hidden]down-> ValidationService
ValidationService -[hidden]down-> WalletService

StationService -[hidden]down-> SessionService
SessionService -[hidden]down-> RatingService
RatingService -[hidden]down-> LoadBalancerService

' ==========================================
' RELAZIONI CORE & PATTERNS
' ==========================================

' Frecce globali verso l'alto (Domain) e verso il basso (DAO)
PKG_SERVICES -up.> PKG_DOMAIN : <<manipulates>>
PKG_SERVICES -down-> PKG_DAO : <<injected DAOs>>

' --- PATTERN OBSERVER ---
PowerTransformer .up.|> Subject : <<implements>>
LoadBalancerService .up.|> Observer : <<implements>>
Subject "1" -down-> "*" Observer : notifies >

' Forziamo l'Observer a puntare in su, verso il blocco Domain
LoadBalancerService -up-> PowerTransformer : observes >
LoadBalancerService -up-> TransformerEvent : receives >

' --- PATTERN STRATEGY ---
' Usiamo -up-> per mandarlo verso il pacchetto Strategies che ora sta in alto
SessionService -up-> ChargingStrategy : <<uses>>
ChargingStrategy <|.. FastChargingStrategy
ChargingStrategy <|.. EcoChargingStrategy

' --- ORCHESTRAZIONE DAEMON ---
' Frecce dirette verso i service in basso
GridMonitor -down-> SessionService : tick/billing >
GridMonitor -down-> StationService : expire holds >
GridMonitor -down-> RatingService : check alerts >
GridMonitor -right-> GridCluster : queries >

LoadBalancerService --> SessionService

' ==========================================
' NOTE ARCHITETTURALI
' ==========================================
note left of PKG_SERVICES
  <b>Architectural Rule:</b>
  Tutti i Service orchestrano il Domain Model
  e incapsulano le transazioni JDBC iniettando
  le interfacce dal package DAO.
end note

note top of GridMonitor
  <b>Thread Safety:</b>
  Il Monitor delega le operazioni
  ai Service, che applicano lock
  sul database (ACID).
end note
@enduml

@enduml