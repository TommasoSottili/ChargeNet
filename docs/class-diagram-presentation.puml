@startuml ChargeNet_Presentation_Layer

skinparam ClassAttributeIconSize 0
skinparam Shadowing false
skinparam RoundCorner 10
skinparam Nodesep 60
skinparam Ranksep 80
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12
skinparam BorderColor #333333
skinparam ArrowColor #333333
skinparam Linetype ortho

top to bottom direction

skinparam class {
  BackgroundColor #FFFFFF
}

skinparam package {
  BorderColor #8c8c8c
  FontStyle bold
}

package "presentation" {

    package "core & infrastructure" as core {
        
        class AppLauncher <<Application>> {
            + {static} primaryStage: Stage
            + start(stage: Stage): void
            + stop(): void
            + main(args: String[]): void
        }

        class GlobalExceptionHandler <<ExceptionHandler>> {
            + uncaughtException(t: Thread, e: Throwable): void
            - showErrorDialog(t: Thread, e: Throwable): void
        }

        package "navigation" {
            class NavigationManager <<Utility>> {
                - {static} FXML_MAP: Map<String, String>
                + {static} navigateTo(viewName: String): void
                + {static} navigateToWithController(viewName: String): T
            }
        }

        package "session" {
            class SessionContext <<State>> {
                - {static} currentUser: User
                + {static} setCurrentUser(user: User): void
                + {static} getCurrentUser(): User
                + {static} logout(): void
            }

            interface SessionUpdateListener <<Interface>> {
                + onTick(): void
            }
        }
    }

    package "controller" {
        
        package "auth" {
            class WelcomeController <<Controller>> {
                - loginBtn: Button
                - registerBtn: Button
                + initialize(): void
                - goToLogin(): void
                - goToRegister(): void
            }

            class LoginController <<Controller>> {
                - emailField: TextField
                - passwordField: PasswordField
                - errorLabel: Label
                - authService: AuthService
                + initialize(): void
                - handleLogin(): void
                - goBack(): void
            }

            class RegisterController <<Controller>> {
                - nameField: TextField
                - emailField: TextField
                - passwordField: PasswordField
                - roleCombo: ComboBox<Role>
                - authService: AuthService
                + initialize(): void
                - handleRegister(): void
                - goBack(): void
            }
        }

        package "driver" {
            class DriverMenuController <<Controller>> {
                - contentArea: BorderPane
                + initialize(): void
                - showBrowseStations(): void
                - showWallet(): void
                - showHistory(): void
            }

            class BrowseStationsController <<Controller>> {
                - stationsTable: TableView<ChargingStation>
                - holdButton: Button
                - startSessionButton: Button
                - stationService: StationService
                + initialize(): void
                - loadStations(): void
                - handleHold(): void
                - handleStartSession(): void
            }

            class ActiveSessionController <<Controller>> {
                - batteryBar: ProgressBar
                - kwhLabel: Label
                - costLabel: Label
                - currentSession: ChargingSession
                - sessionService: SessionService
                + initSession(session: ChargingSession): void
                + onTick(): void
                - updateDisplay(): void
                - handleCloseSession(): void
            }

            class WalletController <<Controller>> {
                - balanceLabel: Label
                - planCombo: ComboBox<SubscriptionPlan>
                - transactionsTable: TableView<Transaction>
                - walletService: WalletService
                + initialize(): void
                - loadWalletData(): void
                - handleFundWallet(): void
                - handleChangePlan(): void
            }

            class ChargingHistoryController <<Controller>> {
                - historyTable: TableView<ChargingSession>
                - sessionService: SessionService
                + initialize(): void
                - loadHistory(): void
            }
        }

        package "operator" {
            class OperatorMenuController <<Controller>> {
                - stationsTable: TableView<ChargingStation>
                - earningsLabel: Label
                - stationService: StationService
                + initialize(): void
                - loadDashboard(): void
                - goToRegisterStation(): void
            }

            class RegisterStationController <<Controller>> {
                - nameField: TextField
                - powerField: TextField
                - connectorCombo: ComboBox<ConnectorType>
                - stationService: StationService
                + initialize(): void
                - handleSubmit(): void
                - goBack(): void
            }
        }

        package "manager" {
            class ManagerDashboardController <<Controller>> {
                - tabPane: TabPane
                - pendingTable: TableView<ChargingStation>
                - alertsTable: TableView<RatingAlert>
                - transformersTable: TableView<PowerTransformer>
                - validationService: ValidationService
                - ratingService: RatingService
                + initialize(): void
                - loadPending(): void
                - loadAlerts(): void
                - loadTransformers(): void
                - handleApprove(): void
                - handleResolveAlert(): void
            }
        }
    }
}

package "business" {
    package "services" {
        class AuthService <<Service>>
        class StationService <<Service>>
        class SessionService <<Service>>
        class ValidationService <<Service>>
        class RatingService <<Service>>
        class WalletService <<Service>>
    }
}

' ==========================================
' FORZATURA SPAZIALE FRA I BLOCCHI PRINCIPALI
' ==========================================
core -[hidden]right- controller
controller -[hidden]right- business

'Compattazione interna a controller
operator -[hidden]down- driver
driver -[hidden]down- auth

'Compattazione interna a core
session -[hidden]right- navigation

' ==========================================
' RELAZIONI EFFETTIVE (Tratteggiate per Loose Coupling)
' ==========================================

AppLauncher ..> GlobalExceptionHandler : <<registers>>
AppLauncher ..> NavigationManager : <<uses>>

' --- AUTH ---
WelcomeController ..> NavigationManager : <<routes>>

LoginController ..> NavigationManager : <<routes>>
LoginController ..> SessionContext : <<sets>>
LoginController ..> AuthService : <<uses>>

RegisterController ..> NavigationManager : <<routes>>
RegisterController ..> AuthService : <<uses>>

' --- DRIVER ---
DriverMenuController ..> NavigationManager : <<routes>>

BrowseStationsController ..> NavigationManager : <<routes>>
BrowseStationsController ..> SessionContext : <<gets>>
BrowseStationsController ..> StationService : <<uses>>

ActiveSessionController ..> NavigationManager : <<routes>>
ActiveSessionController ..> SessionContext : <<gets>>
ActiveSessionController ..|> SessionUpdateListener : <<implements>>
ActiveSessionController ..> SessionService : <<uses>>

WalletController ..> SessionContext : <<gets>>
WalletController ..> WalletService : <<uses>>

ChargingHistoryController ..> SessionContext : <<gets>>
ChargingHistoryController ..> SessionService : <<uses>>

' --- OPERATOR ---
OperatorMenuController ..> NavigationManager : <<routes>>
OperatorMenuController ..> SessionContext : <<gets>>
OperatorMenuController ..> StationService : <<uses>>

RegisterStationController ..> NavigationManager : <<routes>>
RegisterStationController ..> SessionContext : <<gets>>
RegisterStationController ..> StationService : <<uses>>

' --- MANAGER ---
ManagerDashboardController ..> NavigationManager : <<routes>>
ManagerDashboardController ..> ValidationService : <<uses>>
ManagerDashboardController ..> RatingService : <<uses>>

@enduml