@startuml ChargeNet_Presentation
title ChargeNet — Presentation

skinparam ClassAttributeIconSize 0
skinparam Shadowing false
skinparam RoundCorner 10
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12
skinparam BorderColor #333333
skinparam ArrowColor #333333
skinparam Linetype ortho

skinparam class {
  BackgroundColor #FFFFFF
}

skinparam package {
  BorderColor #8c8c8c
  FontStyle bold
}

package "presentation" {

    package "controller" {

        ' ---------- Autenticazione ----------
        class LoginController <<Controller>> {
            - authService : AuthService
            + initialize()
            + handleLogin(e : ActionEvent)
            + routeByRole(user : User)
            + goToRegister(e : ActionEvent)
            - showAlert(type : AlertType, title : String, content : String)
        }

        class RegistrationController <<Controller>> {
            - authService : AuthService
            + initialize()
            + handleRegister(e : ActionEvent)
            + onRoleChanged(e : ActionEvent)
            + goToLogin(e : ActionEvent)
            - showAlert(type : AlertType, title : String, content : String)
        }

        ' ---------- Area Driver ----------
        class DriverMenuController <<Controller>> {
            - loggedDriver : Driver
            - sessionService : SessionService
            + initialize()
            + initData(driver : Driver)
            - refreshResumeCard(driver : Driver)
            + handleUpdateLocation(e : ActionEvent)
            + goToStationExplorer(e : MouseEvent)
            + goToFundWallet(e : MouseEvent)
            + goToHistory(e : MouseEvent)
            + goToAccount(e : MouseEvent)
            + goToActiveSession(e : MouseEvent)
            + handleLogout(e : MouseEvent)
        }

        class StationExplorerController <<Controller>> {
            - loggedDriver : Driver
            - stationService : StationService
            + initialize()
            + initData(driver : Driver)
            - loadStations()
            - createStationCard(station : ChargingStation) : VBox
            - formatDistance(station : ChargingStation) : String
            - handleChargeNow(station : ChargingStation)
            - handleSmartBook(station : ChargingStation)
            + goBack(e : MouseEvent)
        }

        class LiveSessionController <<Controller>> {
            - loggedDriver : Driver
            - station : ChargingStation
            - session : ChargingSession
            - sessionService : SessionService
            - ratingService : RatingService
            - pollTimeline : Timeline
            - selectedRating : int
            + initData(driver : Driver, station : ChargingStation)
            + startSimulation()
            - enterLiveMode(activeSession : ChargingSession)
            - startPolling()
            - refreshFromDb()
            - stopCharging()
            - onSessionEnded()
            - submitRating()
            - skipRating()
            - closeAndReturn()
            + goBack(e : MouseEvent)
        }

        class ChargingHistoryController <<Controller>> {
            - loggedDriver : Driver
            - sessionService : SessionService
            + initialize()
            - loadHistory()
            - createSessionCard(s : ChargingSession) : HBox
            + goBack(e : MouseEvent)
        }

        class FundWalletController <<Controller>> {
            - loggedDriver : Driver
            - walletService : WalletService
            - selectedAmount : BigDecimal
            + initialize()
            - setPreset(amount : BigDecimal, chosen : Button)
            - confirmAndPay(e : ActionEvent)
            - showBalance(balance : BigDecimal)
            + goBack(e : MouseEvent)
        }

        class AccountController <<Controller>> {
            - loggedDriver : Driver
            - walletService : WalletService
            - selectedPlan : SubscriptionPlan
            + initialize()
            - renderFromDriver()
            - planDescription(plan : SubscriptionPlan) : String
            - choose(plan : SubscriptionPlan)
            - applyPlanChange()
            + goToFundWallet(e : MouseEvent)
            + goBack(e : MouseEvent)
        }

        ' ---------- Area Station Operator ----------
        class OperatorMenuController <<Controller>> {
            - loggedOperator : StationOperator
            - sessionService : SessionService
            + initialize()
            - loadDashboardData()
            + goToHub(e : MouseEvent)
            + goToReports(e : MouseEvent)
            + logOut(e : MouseEvent)
        }

        class StationHubController <<Controller>> {
            - loggedOperator : StationOperator
            - stationService : StationService
            + initialize()
            - loadOperatorStations()
            - createOperatorStationCard(station : ChargingStation) : VBox
            + goToOnboard(e : MouseEvent)
            + goBack(e : MouseEvent)
        }

        class NewStationController <<Controller>> {
            - loggedOperator : StationOperator
            - stationService : StationService
            + initialize()
            - handleDeploy(e : MouseEvent)
            - clearFields()
            + goBack(e : MouseEvent)
        }

        class FinancialReportsController <<Controller>> {
            - loggedOperator : StationOperator
            - sessionService : SessionService
            + initialize()
            - loadFinancialData()
            + goBack(e : MouseEvent)
        }

        ' ---------- Area Energy Manager ----------
        class EnergyManagerMenuController <<Controller>> {
            - stationService : StationService
            + initialize()
            - loadDashboardData()
            + goToApprovalQueue(e : MouseEvent)
            + goToRatingIncidents(e : MouseEvent)
            + goToGridDashboard(e : MouseEvent)
            + logOut(e : MouseEvent)
        }

        class ApprovalQueueController <<Controller>> {
            - stationService : StationService
            - validationService : ValidationService
            + initialize()
            - loadQueue()
            - buildStationCard(s : ChargingStation) : VBox
            - onApprove(s : ChargingStation)
            - onReject(s : ChargingStation)
            - askPlatformTariff(s : ChargingStation) : Optional<BigDecimal>
            + goBack(e : MouseEvent)
        }

        class RatingIncidentManagerController <<Controller>> {
            - ratingService : RatingService
            + initialize()
            - loadAlerts()
            - buildAlertCard(a : RatingAlert) : VBox
            - onSuspend(a : RatingAlert)
            - onDismiss(a : RatingAlert)
            - askNotes(title : String, header : String) : Optional<String>
            + goBack(e : MouseEvent)
        }

        class ReliabilityDashboardController <<Controller>> {
            - stationService : StationService
            + initialize()
            - startPolling()
            - refresh()
            - buildTransformerCard(t : PowerTransformer) : VBox
            - loadColor(load : double, alert : boolean) : String
            + goBack(e : MouseEvent)
        }
    }

    package "navigation" {
        class NavigationManager <<Service Locator>> {
            + {static} initialize(stage : Stage, daoFactory : DaoFactory)
            + {static} navigateTo(key : String)
            + {static} getCurrentUser() : User
            + {static} loginUser(user : User)
            + {static} logout()
            .. Service Locator ..
            + {static} getAuthService() : AuthService
            + {static} getSessionService() : SessionService
            + {static} getStationService() : StationService
            + {static} getValidationService() : ValidationService
            + {static} getRatingService() : RatingService
            + {static} getWalletService() : WalletService
            + {static} getDriverService() : DriverService
            + {static} getDaoFactory() : DaoFactory
        }
    }

    package "core" {
        class AppLauncher <<Application>> {
            + {static} primaryStage : Stage
            + start(stage : Stage)
            + stop()
            + {static} main(args : String[])
        }

        class GlobalExceptionHandler {
            + uncaughtException(t : Thread, e : Throwable)
        }
    }
}

package "javafx.application" <<external>> {
    abstract class Application
}

package "business" <<layer>> {
    class "(Service, GridCluster, GridMonitor)" as BUSINESS
}

interface "Thread.UncaughtExceptionHandler" as UEH <<external>>

' ============================ RELAZIONI ============================
' Tutti i controller dipendono da NavigationManager (Service Locator):
' getCurrentUser(), getXxxService(...), navigateTo(...). Le frecce dai
' singoli controller sono riassunte nell'unica dipendenza qui sotto,
' per leggibilita'.
controller ..> NavigationManager : <<service locator>>
NavigationManager ..> BUSINESS : <<risolve i Service>>

AppLauncher --|> Application
AppLauncher ..> NavigationManager : <<initialize / navigateTo("LOGIN")>>
AppLauncher ..> BUSINESS : <<init GridCluster, GridMonitor, Observer>>
AppLauncher ..> GlobalExceptionHandler : <<registra come handler globale>>
GlobalExceptionHandler ..|> UEH

note right of NavigationManager
  **NavigationManager NON dipende dai controller.**
  E' JavaFX a istanziarli via reflection durante il
  caricamento degli .fxml: per questo i controller non
  possono ricevere i Service nel costruttore
  (Dependency Injection) e vanno a chiederli qui
  (**Service Locator**).
  La dipendenza e' a senso unico: controller --> navigation.
end note

@enduml
